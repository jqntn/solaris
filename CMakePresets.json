{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug",        "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release",      "configurePreset": "x64", "configuration": "Release" },
    { "name": "x64-distrib",      "configurePreset": "x64", "configuration": "Release", "targets": ["distrib"] }
  ],
  "testPresets": [
    { "name": "x64-debug",   "configurePreset": "x64", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "distrib",
      "steps": [
        { "type": "configure", "name": "x64" },
        { "type": "build",     "name": "x64-distrib" }
      ]
    }
  ]
}
